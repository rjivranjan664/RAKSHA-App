# Frontend: leave empty during local development so Vite proxies /api and /media.
VITE_API_BASE_URL=

# Backend runtime
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# Backend-only emergency family notification. TextBee is the primary integration.
# Keep the real key in .env; never commit it. TextBee requires an Android phone/SIM registered to the account.
TEXTBEE_API_KEY=my_key
TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1

# Optional provider-neutral SMS fallback (used only when TEXTBEE_API_KEY is empty).
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_HEADER_NAME=x-api-key

# Backend-only Gemini AI configuration.
# Keep the real key in .env; never put it in React/Vite/public files.
GEMINI_API_KEY=my_key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Optional legacy/provider-neutral AI gateway fallback. Used only when GEMINI_API_KEY is empty.
AI_API_KEY=
AI_API_KEY_HEADER=x-goog-api-key
AI_INTERACTIONS_URL=
AI_GENERATE_URL=
AI_MODEL=

# Clearly marked fallback used only when browser location is unavailable/denied.
DEMO_FALLBACK_LAT=22.9734
DEMO_FALLBACK_LON=78.6569
